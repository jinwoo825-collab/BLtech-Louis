# ===== 환경변수 예시 (템플릿) =====
# ⚠️ 이 파일에는 "실제 키"를 넣지 마세요. 변수 이름만 참고하는 용도입니다.
# ⚠️ 실제 값은 Vercel 대시보드에 넣습니다:
#     Vercel → 프로젝트 b-ltech-louis → Settings → Environment Variables
#     (이 앱의 챗봇 함수는 Vercel에서만 실행되므로, 로컬 .env 파일은 사용되지 않습니다.)
#
# 로컬에서 Node로 직접 테스트할 때만 이 파일을 복사해 .env 로 만들고 값을 채우세요.
# (.env 는 .gitignore 로 제외되어 GitHub에 올라가지 않습니다.)

# --- 임직원 AI 도우미 (OpenAI) ---
OPENAI_API_KEY=sk-여기에_새로_발급한_OpenAI_키
OPENAI_MODEL=gpt-5.5
ASSISTANT_PASSCODE=사내접속코드_예시_bltech2026

# --- 대표이사 AI 비서 (Anthropic Claude) : 사용할 경우 ---
# ANTHROPIC_API_KEY=sk-ant-여기에_Anthropic_키
# BL_CHAT_PASSCODE=선택_비밀번호
